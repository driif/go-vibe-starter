# Project-local ralphex config. Only the keys set here override ralphex's
# embedded defaults; everything else falls back to them.

# Execution plans live here. Finished plans move to docs/plans/completed/.
plans_dir = docs/plans

# No trailer on generated commits. This repo forbids AI attribution in commit
# messages, PR bodies, and issues — an empty value keeps ralphex from adding one.
commit_trailer =

# Plans validate with the canonical Makefile targets, declared per plan under
# "## Validation Commands":
#   make test   -> go test -race ./...
#   make lint   -> golangci-lint run
