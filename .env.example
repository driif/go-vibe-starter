# Local development values. The process environment takes precedence over .env.local.
# The binary has no built-in auth provider or database connection.
# Every supported variable is documented in docs/agents/env-reference.md.
APP_ENVIRONMENT=development
AUTH_PROVIDER=none
AUTH_DEV_ROLES=admin
DATABASE_URL=postgres://app:app@localhost:5434/app?sslmode=disable
KEYCLOAK_ISSUER_URL=http://localhost:8181/realms/app
KEYCLOAK_AUDIENCE=api
LISTEN_ADDR=127.0.0.1:8080
MANAGEMENT_ADDR=127.0.0.1:9090
#CORS_ALLOWED_ORIGINS=
#LOG_LEVEL=INFO
