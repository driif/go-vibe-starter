# Every environment variable read by internal/server/config, with its built-in default.
#
# Copy to .env.local and uncomment only what you need to change:
#
#   cp .env.example .env.local
#
# .env.local is loaded at startup and overrides the process environment.
# It is never loaded while tests run (CI is set, or the binary ends in .test).
# Keep this file in sync with docs/agents/env-reference.md.

# --- App -----------------------------------------------------------------------

#APP_ENVIRONMENT=development                    # environment name; "production" enables strict startup checks
#PROJECT_ROOT_DIR=                              # root used to find .env.local and migrations/ (default: directory of the binary)

# --- Auth ----------------------------------------------------------------------

#AUTH_PROVIDER=none                             # "none" (dev principal, forbidden in production) or "keycloak"
#AUTH_DEV_SUBJECT=local-dev                     # subject of the injected principal when AUTH_PROVIDER=none
#AUTH_DEV_ROLES=admin                           # comma-separated roles of that principal

# --- Server --------------------------------------------------------------------

#SERVICE_PORT=:8080                             # HTTP listen address

# --- Middleware toggles --------------------------------------------------------

#SERVER_ENABLE_CORS_MIDDLEWARE=true             # CORS headers
#SERVER_ENABLE_LOGGER_MIDDLEWARE=true           # request/response logging
#SERVER_ENABLE_RECOVER_MIDDLEWARE=true          # panic recovery, returns 500
#SERVER_ENABLE_REQUEST_ID_MIDDLEWARE=true       # X-Request-Id header
#SERVER_ENABLE_TRAILING_SLASH_MIDDLEWARE=true   # strip trailing slashes from URLs
#SERVER_ENABLE_SECURE_MIDDLEWARE=true           # security headers below
#SERVER_ENABLE_CACHE_CONTROL_MIDDLEWARE=true    # Cache-Control: no-store

# --- Security headers ----------------------------------------------------------

#SERVER_SECURE_XSS_PROTECTION=1; mode=block     # X-XSS-Protection
#SERVER_SECURE_CONTENT_TYPE_NOSNIFF=nosniff     # X-Content-Type-Options
#SERVER_SECURE_X_FRAME_OPTIONS=SAMEORIGIN       # X-Frame-Options
#SERVER_SECURE_HSTS_MAX_AGE=0                   # Strict-Transport-Security max-age; 0 disables the header
#SERVER_SECURE_HSTS_EXCLUDE_SUBDOMAINS=false    # omit includeSubDomains from HSTS
#SERVER_SECURE_HSTS_PRELOAD_ENABLED=false       # add preload to HSTS
#SERVER_SECURE_CONTENT_SECURITY_POLICY=         # Content-Security-Policy; empty disables the header
#SERVER_SECURE_CSP_REPORT_ONLY=false            # send the CSP as Content-Security-Policy-Report-Only
#SERVER_SECURE_REFERRER_POLICY=                 # Referrer-Policy; empty disables the header

# --- Logger --------------------------------------------------------------------

#SERVER_LOGGER_LEVEL=DEBUG                      # global level: DEBUG, INFO, WARN, ERROR
#SERVER_LOGGER_REQUEST_LEVEL=DEBUG              # level of request/response log records
#SERVER_LOGGER_LOG_REQUEST_BODY=false           # log request bodies (form and multipart are skipped)
#SERVER_LOGGER_LOG_REQUEST_HEADER=false         # log request headers (Authorization redacted)
#SERVER_LOGGER_LOG_REQUEST_QUERY=false          # log URL query parameters
#SERVER_LOGGER_LOG_RESPONSE_BODY=false          # log response bodies (JSON only)
#SERVER_LOGGER_LOG_RESPONSE_HEADER=false        # log response headers

# --- Database ------------------------------------------------------------------

#PGHOST=postgres                                # PostgreSQL host; use localhost outside docker compose
#PGPORT=5432                                    # PostgreSQL port
#PGDATABASE=development                         # database name
#PGUSER=dbuser                                  # database user
#PGPASSWORD=dbpass                              # database password (sensitive)
#PGSSLMODE=disable                              # sslmode connection parameter
#DB_MAX_OPEN_CONNS=                             # max open connections (default: NumCPU * 2)
#DB_MAX_IDLE_CONNS=1                            # max idle connections
#DB_CONN_MAX_LIFETIME_SEC=60                    # max connection lifetime in seconds

# --- Keycloak (token verification, used when AUTH_PROVIDER=keycloak) -----------

#KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/myrealm  # OIDC issuer used for discovery and iss validation
#KEYCLOAK_AUDIENCE=api                          # expected access-token audience
#KEYCLOAK_HTTP_TIMEOUT_SEC=5                    # timeout for discovery and JWKS requests, in seconds
#KEYCLOAK_CLOCK_SKEW_SEC=30                     # allowed clock skew when validating token times, in seconds
#KEYCLOAK_ISS=                                  # legacy fallback for KEYCLOAK_ISSUER_URL
#KEYCLOAK_CLIENT_ID=                            # legacy fallback for KEYCLOAK_AUDIENCE

# --- Keycloak admin API --------------------------------------------------------

#KEYCLOAK_ADMIN_BASE_URL=http://localhost:8080  # Keycloak base URL for admin calls
#KEYCLOAK_ADMIN_REALM=myrealm                   # realm managed through the admin API
#KEYCLOAK_ADMIN_CLIENT_ID=                      # service-account client id
#KEYCLOAK_ADMIN_CLIENT_SECRET=                  # service-account client secret (sensitive)

# --- Pprof and management ------------------------------------------------------

#SERVER_PPROF_ENABLE=false                      # mount /debug/pprof routes
#SERVER_PPROF_ENABLE_MANAGEMENT_KEY_AUTH=true   # guard pprof with ?mgmt-secret=
#SERVER_PPROF_RUNTIME_MUTEX_PROFILE_FRACTION=0  # runtime.SetMutexProfileFraction value; 0 is off
#SERVER_MANAGEMENT_SECRET=                      # value expected in ?mgmt-secret= (sensitive)
